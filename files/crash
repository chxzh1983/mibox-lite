#!/bin/sh
# mibox-lite — 小米 MiWiFi (AX3600) 单内核 sing-box 精简代理 + DNS 广告拦截
# 由 ShellCrash (juewuy, GPL-3.0) 裁剪: 砍双内核/多设备适配/TG机器人/多面板/自动任务,
# 保留: sing-box 内核 + zashboard 面板 + 订阅导入 + DNS 广告拦截 + CN 直连分流 + 自启 + 看门狗
# 一条命令安装, 无交互菜单。闪存缓存 /data/SClite, 内核运行态 /tmp/SClite。

SCDIR=/data/SClite
RULEDIR=$SCDIR/rules
UIDIR=$SCDIR/ui
TMP=/tmp/SClite
CFG=$SCDIR/config

# ---- 下载源 (jsdelivr 国内直连; 内核/CN srs 与 ShellCrash 官方配套, 版本自洽) ----
SBCORE="https://testingcf.jsdelivr.net/gh/juewuy/ShellCrash@update/bin/singbox/singbox-linux-arm64.tar.gz"
SBCORE_FALLBACK="https://testingcf.jsdelivr.net/gh/juewuy/ShellCrash@master/bin/singbox/singbox-linux-arm64.tar.gz"
# 广告: ApolloRioo source json ({"rules":[{"domain":[...]}]}, 每20分钟更新, 本地编译 srs 无版本风险)
AD_JSON="https://testingcf.jsdelivr.net/gh/ApolloRioo/AdBlock_Rule_For_Sing-box@main/adblock_reject_domain.json"
# CN 分流: ShellCrash 官方 srs (与其 sing-box 内核版本配套)
CN_DOMAIN_SRS="https://testingcf.jsdelivr.net/gh/juewuy/ShellCrash@master/bin/geodata/srs_geosite_cn.srs"
CN_IP_SRS="https://testingcf.jsdelivr.net/gh/juewuy/ShellCrash@master/bin/geodata/srs_geoip_cn.srs"
# 面板: zashboard
UI_DEFAULT="https://testingcf.jsdelivr.net/gh/juewuy/ShellCrash@master/bin/dashboard/zashboard.tar.gz"
# subconverter 公共实例 (可换自建)
SUBCONV_LIST="https://api.v1.mk/sub https://sub.jwsc.eu.org/sub https://url.v1.mk/sub"

# ---- 默认配置 (可被 $CFG 覆盖, 值加单引号) ----
mix_port=7890; redir_port=7892; dns_port=1053; db_port=9999
direct_dns=1.12.12.12
adblock=ON; cn_split=ON; dns_hijack=ON
secret=''; ui_url=$UI_DEFAULT; sub_url=''
[ -f "$CFG" ] && . "$CFG" 2>/dev/null

log()  { printf '\033[32m[mibox]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[mibox]\033[0m %s\n' "$*"; }
err()  { printf '\033[31m[mibox]\033[0m %s\n' "$*" >&2; }

dl() { # $1=out $2=url [$3=url...]
    out=$1; shift
    for u in "$@"; do
        command -v curl >/dev/null 2>&1 && { curl -fsSL -m 180 -o "$out" "$u" && return 0; }
        command -v wget >/dev/null 2>&1 && { wget -q -T 180 -O "$out" "$u" && return 0; }
    done
    return 1
}
# 写配置项 (值单引号转义)
setcfg() {
    v=$(printf '%s' "$2" | sed "s/'/'\\\\''/g")
    if grep -q "^$1=" "$CFG" 2>/dev/null; then sed -i "s|^$1=.*|$1='$v'|" "$CFG"
    else echo "$1='$v'" >> "$CFG"; fi
}
lan_ip() {
    ip=$(ip -4 addr 2>/dev/null | grep -oE 'inet (192\.168|10\.|172\.)[0-9.]+' | awk '{print $2}' | grep -v '192.168.1.1$' | head -n1)
    [ -z "$ip" ] && ip=192.168.31.1
    echo "$ip"
}
# 单次 sed 扫描 URL 编码 (POSIX, busybox 兼容; 订阅 URL 只含 URL-safe 字符 + 少量特殊符)
urlencode() {
    printf '%s' "$1" | sed 's/ /%20/g; s/&/%26/g; s/+/%2B/g; s/?/%3F/g; s/=/%3D/g; s/:/%3A/g; s/#/%23/g; s/@/%40/g; s/!/%21/g'
}

# ---------- 内核 (闪存存 tgz, /tmp 解压运行) ----------
core_prepare() {
    [ -x "$TMP/CrashCore" ] && return 0
    [ -f "$SCDIR/CrashCore.tgz" ] || { err "内核未缓存, 先执行 install 或 update"; return 1; }
    rm -rf "$TMP/core_x"; mkdir -p "$TMP/core_x"
    tar -xzf "$SCDIR/CrashCore.tgz" -C "$TMP/core_x" 2>/dev/null
    bin=$(find "$TMP/core_x" -type f 2>/dev/null | head -n1)
    [ -n "$bin" ] || { err "内核解压失败"; return 1; }
    cp -f "$bin" "$TMP/CrashCore"; chmod +x "$TMP/CrashCore"
    rm -rf "$TMP/core_x"
    log "内核就绪: $( "$TMP/CrashCore" version 2>/dev/null | grep -m1 version )"
    return 0
}

# ---------- 资源缓存 ----------
fetch_resources() { # $1=force(1=强制重下)
    re=$1
    mkdir -p "$RULEDIR" "$UIDIR" "$TMP"
    # 1) 内核
    if [ ! -f "$SCDIR/CrashCore.tgz" ] || [ "$re" = 1 ]; then
        log "下载 sing-box 内核 ..."
        dl "$TMP/core.tgz" "$SBCORE" "$SBCORE_FALLBACK" || { err "内核下载失败"; return 1; }
        mv -f "$TMP/core.tgz" "$SCDIR/CrashCore.tgz"
        log "内核缓存: $(du -h "$SCDIR/CrashCore.tgz" | awk '{print $1}')"
    fi
    # 2) 广告 source json (闪存存, 编译 srs)
    if [ ! -s "$RULEDIR/adblock.source.json" ] || [ "$re" = 1 ]; then
        log "下载广告拦截规则 (~7.5MB) ..."
        dl "$RULEDIR/adblock.source.json" "$AD_JSON" || warn "广告规则下载失败, 本次关闭广告拦截"
        [ -s "$RULEDIR/adblock.source.json" ] && grep -q '"rules"' "$RULEDIR/adblock.source.json" 2>/dev/null || warn "广告 json 异常, 本次关闭广告拦截"
    fi
    adblock_compile
    # 3) CN 分流 srs (可选, 失败降级全代理)
    [ "$cn_split" = ON ] && {
        [ -s "$RULEDIR/cn-domain.srs" ] || dl "$RULEDIR/cn-domain.srs" "$CN_DOMAIN_SRS" || warn "cn-domain 下载失败, 全量走代理"
        [ -s "$RULEDIR/cn-ip.srs" ] || dl "$RULEDIR/cn-ip.srs" "$CN_IP_SRS" || warn "cn-ip 下载失败"
    }
    # 4) 面板
    if [ ! -f "$UIDIR/index.html" ] || [ "$re" = 1 ]; then
        log "下载面板 ..."
        if dl "$TMP/ui.tgz" "$ui_url" "$UI_DEFAULT"; then
            rm -rf "$TMP/ui_tmp"; mkdir -p "$TMP/ui_tmp"
            tar -zxf "$TMP/ui.tgz" -C "$TMP/ui_tmp" 2>/dev/null
            inner=$(find "$TMP/ui_tmp" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -n1)
            rm -rf "$UIDIR"; mkdir -p "$UIDIR"
            [ -n "$inner" ] && cp -rf "$inner"/. "$UIDIR/" || cp -rf "$TMP/ui_tmp"/. "$UIDIR/"
            ui_rewrite; rm -rf "$TMP/ui_tmp" "$TMP/ui.tgz"
            log "面板: http://$(lan_ip):$db_port/ui"
        else
            warn "面板下载失败 (不影响代理)"
        fi
    fi
    return 0
}
# 广告 source json -> srs (用内核自带 CLI 编译, 版本永远匹配; 1.13 内核 srs version 4)
adblock_compile() {
    [ "$adblock" = ON ] || return 0
    [ ! -s "$RULEDIR/adblock.source.json" ] && { warn "无广告 source json, 跳过编译"; return 0; }
    # 已编译且 source json 未变则跳过 (看门狗高频调用时省 CPU)
    if [ -s "$RULEDIR/adblock.srs" ] && [ "$RULEDIR/adblock.srs" -nt "$RULEDIR/adblock.source.json" ]; then
        return 0
    fi
    core_prepare || return 1
    # 在第一行 { 后插入 version 字段 (1.13.x srs version 4; 编译失败回退 3)
    [ -s "$TMP/adblock.v.json" ] && rm -f "$TMP/adblock.v.json"
    awk 'NR==1{print $0 " \"version\": 4,"; next}{print}' "$RULEDIR/adblock.source.json" > "$TMP/adblock.v.json"
    if "$TMP/CrashCore" rule-set compile "$TMP/adblock.v.json" -o "$RULEDIR/adblock.srs" 2>"$TMP/adblock.err"; then
        log "广告规则编译成功: $(du -h "$RULEDIR/adblock.srs" | awk '{print $1}')"
    else
        warn "v4 编译失败, 回退 v3: $(tail -n1 "$TMP/adblock.err" 2>/dev/null)"
        awk 'NR==1{print $0 " \"version\": 3,"; next}{print}' "$RULEDIR/adblock.source.json" > "$TMP/adblock.v.json"
        "$TMP/CrashCore" rule-set compile "$TMP/adblock.v.json" -o "$RULEDIR/adblock.srs" 2>/dev/null \
            || { warn "广告规则编译失败, 本次关闭广告拦截"; rm -f "$RULEDIR/adblock.srs"; }
    fi
    rm -f "$TMP/adblock.v.json" "$TMP/adblock.err"
}
# 改写面板写死的 127.0.0.1:9090 -> 路由器IP:db_port
ui_rewrite() {
    host=$(lan_ip)
    find "$UIDIR" \( -name '*.js' -o -name '*.html' \) 2>/dev/null | while read -r f; do
        sed -i "s/127\.0\.0\.1:9090/$host:$db_port/g; s/127\.0\.0\.1/$host/g; s/:9090/:$db_port/g" "$f" 2>/dev/null
    done
}

# ---------- 配置生成 (base.json + nodes.json, run -C 目录合并) ----------
gen_config() {
    mkdir -p "$TMP/fragments"
    core_prepare || return 1
    [ -z "$secret" ] && { secret=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n' | cut -c1-32); setcfg secret "$secret"; }

    has_nodes=0; [ -s "$SCDIR/nodes.json" ] && has_nodes=1
    has_ad=0;   [ -s "$RULEDIR/adblock.srs" ] && [ "$adblock" = ON ] && has_ad=1
    has_cn=0;   [ -s "$RULEDIR/cn-domain.srs" ] && [ -s "$RULEDIR/cn-ip.srs" ] && [ "$cn_split" = ON ] && has_cn=1

    {
    printf '{\n'
    printf '  "log": { "level": "warning", "timestamp": true },\n'
    # ---- DNS: 私网直连 / 广告拒绝 / CN 直连 / 其余 fakeip(走代理, reverse_mapping 防污染) ----
    printf '  "dns": {\n    "servers": [\n'
    [ "$has_nodes" = 1 ] && printf '      { "tag": "fakeip", "type": "fakeip", "inet4_range": "198.18.0.0/15", "detour": "GLOBAL" },\n'
    printf '      { "tag": "dns-direct", "type": "udp", "server": "%s", "routing_mark": 255, "strategy": "ipv4_only" }\n' "$direct_dns"
    printf '    ],\n    "rules": [\n'
    printf '      { "ip_is_private": true, "server": "dns-direct" },\n'
    [ "$has_cn" = 1 ] && printf '      { "rule_set": [ "cn-domain" ], "server": "dns-direct" },\n'
    if [ "$has_nodes" = 1 ]; then printf '      { "query_type": [ "A", "AAAA" ], "server": "fakeip", "rewrite_ttl": 1 }\n'
    else printf '      { "query_type": [ "A", "AAAA" ], "server": "dns-direct" }\n'; fi
    printf '    ],\n'
    printf '    "final": "%s",\n' "$([ "$has_nodes" = 1 ] && echo fakeip || echo dns-direct)"
    printf '    "strategy": "ipv4_only",\n    "reverse_mapping": true\n  },\n'
    # ---- 入站: 混合代理(本机/SSH) + 透明重定向 + DNS ----
    printf '  "inbounds": [\n'
    printf '    { "type": "mixed", "tag": "mixed-in", "listen": "127.0.0.1", "listen_port": %s },\n' "$mix_port"
    printf '    { "type": "redirect", "tag": "redirect-in", "listen": "0.0.0.0", "listen_port": %s },\n' "$redir_port"
    printf '    { "type": "direct", "tag": "dns-in", "listen": "0.0.0.0", "listen_port": %s }\n  ],\n' "$dns_port"
    # ---- 出站框架 (订阅节点+GLOBAL 在 nodes.json, 此处只提供 DIRECT/REJECT; 无订阅时兜底 GLOBAL) ----
    printf '  "outbounds": [\n    { "tag": "DIRECT", "type": "direct" },\n'
    if [ "$has_nodes" = 0 ]; then
        printf '    { "tag": "REJECT", "type": "block" },\n'
        printf '    { "tag": "GLOBAL", "type": "selector", "outbounds": [ "DIRECT" ], "default": "DIRECT" }\n'
    else
        printf '    { "tag": "REJECT", "type": "block" }\n'
    fi
    printf '  ],\n'
    # ---- 路由 ----
    printf '  "route": {\n'
    # rule_set 声明 (4 种组合, 保证 JSON 合法)
    if [ "$has_ad" = 1 ] && [ "$has_cn" = 1 ]; then
        printf '    "rule_set": [\n'
        printf '      { "tag": "adblock", "type": "local", "format": "binary", "path": "rules/adblock.srs" },\n'
        printf '      { "tag": "cn-domain", "type": "local", "format": "binary", "path": "rules/cn-domain.srs" },\n'
        printf '      { "tag": "cn-ip", "type": "local", "format": "binary", "path": "rules/cn-ip.srs" }\n'
        printf '    ],\n'
    elif [ "$has_ad" = 1 ]; then
        printf '    "rule_set": [\n'
        printf '      { "tag": "adblock", "type": "local", "format": "binary", "path": "rules/adblock.srs" }\n'
        printf '    ],\n'
    elif [ "$has_cn" = 1 ]; then
        printf '    "rule_set": [\n'
        printf '      { "tag": "cn-domain", "type": "local", "format": "binary", "path": "rules/cn-domain.srs" },\n'
        printf '      { "tag": "cn-ip", "type": "local", "format": "binary", "path": "rules/cn-ip.srs" }\n'
        printf '    ],\n'
    fi
    printf '    "rules": [\n'
    printf '      { "inbound": [ "dns-in" ], "action": "hijack-dns" },\n'
    [ "$has_nodes" = 1 ] && printf '      { "ip_cidr": [ "198.18.0.0/15" ], "outbound": "GLOBAL" },\n'
    [ "$has_cn" = 1 ] && printf '      { "rule_set": [ "cn-domain", "cn-ip" ], "outbound": "DIRECT" },\n'
    printf '      { "ip_is_private": true, "outbound": "DIRECT" }\n'
    printf '    ],\n    "default_mark": 255,\n    "clamp_packet_size": true,\n'
    printf '    "final": "%s"\n  },\n' "$([ "$has_nodes" = 1 ] && echo GLOBAL || echo DIRECT)"
    # ---- 面板 API (zashboard 对接) ----
    printf '  "experimental": {\n    "clash_api": {\n'
    printf '      "external_controller": "0.0.0.0:%s",\n' "$db_port"
    printf '      "external_ui": "ui",\n'
    printf '      "secret": "%s",\n' "$secret"
    printf '      "default_mode": "Rule"\n    }\n  }\n}\n'
    } > "$TMP/fragments/base.json"

    # 节点片段 (crash sub 导入后才有; 无节点时 final=DIRECT 纯直连+广告拦截)
    [ "$has_nodes" = 1 ] && cp -f "$SCDIR/nodes.json" "$TMP/fragments/nodes.json" || rm -f "$TMP/fragments/nodes.json"

    "$TMP/CrashCore" check -D "$SCDIR" -C "$TMP/fragments" >/dev/null 2>&1 \
        || warn "配置校验未通过 (仍尝试启动, 查 $TMP/sb.log)"
    log "配置: 节点${has_nodes} 广告${has_ad} CN分流${has_cn}"
    return 0
}

# ---------- 订阅导入 (subconverter target=singbox -> outbounds/providers + 自建 GLOBAL) ----------
sub_import() {
    case "$1" in
        http*|https*|vless*|vmess*|trojan*|ss*|hy*|hysteria*|tuic*|anytls*) : ;;
        *) err "订阅/节点地址需以 http(s) 或节点协议开头"; return 1 ;;
    esac
    [ -d "$TMP" ] || mkdir -p "$TMP"
    log "转换订阅 ..."
    enc=$(urlencode "$1")
    out=0
    for srv in $SUBCONV_LIST; do
        rm -f "$TMP/sub.raw"
        if dl "$TMP/sub.raw" "$srv?target=singbox&insert=true&scv=true&udp=true&new_name=true&url=$enc" \
           && grep -q '"outbounds"' "$TMP/sub.raw" 2>/dev/null; then
            out=1; break
        fi
    done
    [ "$out" = 1 ] || { err "订阅转换失败 (subconverter 不可达或订阅为空)"; return 1; }
    build_nodes "$TMP/sub.raw" "$SCDIR/nodes.json" || { err "节点解析失败"; return 1; }
    rm -f "$TMP/sub.raw"
    log "已导入 $(grep -c '"tag"' "$SCDIR/nodes.json" 2>/dev/null || echo 0) 个标签"
    setcfg sub_url "$1"
    service_restart
    return 0
}
# 从 subconverter 输出提取节点 outbounds + providers, 前置自建 GLOBAL selector
# 规则: 节点/策略组 tag 全部并入 GLOBAL (默认选"自动"类), 剔除 subconverter 自带的
#       DIRECT/REJECT/GLOBAL (base.json 已提供 DIRECT/REJECT, 防 tag 冲突)
build_nodes() { # $1=raw $2=dst
    awk '
    function extract(name,   p,i,c,d,ch,len) {
        p = index(buf, "\"" name "\":")
        if (p == 0) return ""
        i = p; len = length(buf)
        while (i <= len && substr(buf,i,1) != "[") i++
        if (i > len) return ""
        d = 0; c = i
        while (c <= len) { ch = substr(buf,c,1); if (ch=="[") d++; else if (ch=="]") { d--; if (d==0) break } c++ }
        return substr(buf, i, c-i+1)
    }
    # 收集顶层对象里的 tag (outbounds: 节点+策略组; providers: 不并入 GLOBAL)
    function collect(s,   t) {
        while (match(s, /"tag"[ \t]*:[ \t]*"[^"]*"/)) {
            t = substr(s, RSTART, RLENGTH); sub(/^"tag"[ \t]*:[ \t]*"/, "", t); sub(/"$/, "", t)
            if (t != "DIRECT" && t != "REJECT" && t != "GLOBAL" && index(globtags, t) == 0)
                globtags = globtags (globtags == "" ? "" : ", ") "\"" t "\""
            s = substr(s, RSTART + RLENGTH)
        }
    }
    # 按顶层 {...} 拆分数组, 跳过 tag 为 DIRECT/REJECT/GLOBAL 的对象
    function topobjs(arr,   i,c,d,start,obj,out,n) {
        sub(/^[ \t]*\[/, "", arr); sub(/\][ \t]*$/, "", arr)
        out = ""; n = 0; i = 1
        while (i <= length(arr)) {
            c = substr(arr, i, 1)
            if (c == "{") {
                d = 0; start = i
                while (i <= length(arr)) {
                    ch = substr(arr, i, 1)
                    if (ch == "{") d++; else if (ch == "}") { d--; if (d == 0) break }
                    i++
                }
                obj = substr(arr, start, i - start + 1)
                if (obj !~ /"tag"[ \t]*:[ \t]*"(DIRECT|REJECT|GLOBAL)"/) {
                    out = out (n > 0 ? ",\n    " : "") obj
                    n++
                }
                i++
            } else i++
        }
        return out
    }
    BEGIN { buf = ""; globtags = "" }
    { buf = buf $0 "\n" }
    END {
        ob = extract("outbounds"); pv = extract("providers")
        collect(ob)
        gdef = ""
        if (globtags != "") {
            n = split(globtags, tg, /, /)
            for (k = 1; k <= n; k++) {
                tt = substr(tg[k], 2, length(tg[k]) - 2)
                if (tt ~ /自动|auto|urltest|UrlTest|PROXY|Global/) { gdef = tt; break }
            }
            if (gdef == "") gdef = substr(tg[1], 2, length(tg[1]) - 2)
        }
        nodes = topobjs(ob)
        print "{"
        print "  \"outbounds\": ["
        if (globtags != "")
            printf "    { \"tag\": \"GLOBAL\", \"type\": \"selector\", \"outbounds\": [ %s, \"DIRECT\" ], \"default\": \"%s\" },\n", globtags, gdef
        else
            printf "    { \"tag\": \"GLOBAL\", \"type\": \"selector\", \"outbounds\": [ \"DIRECT\" ], \"default\": \"DIRECT\" }\n"
        if (nodes != "") {
            printf "%s\n", nodes
        }
        print "  ],"
        if (pv != "") { gsub(/^[ \t]*\[/, "", pv); gsub(/\][ \t]*$/, "", pv); print "  \"providers\": ["; printf "    %s\n", pv; print "  ]" }
        else print "  \"providers\": []"
        print "}"
    }' "$1" > "$2"
    grep -q '"outbounds"' "$2" || return 1
    return 0
}

# ---------- 服务 ----------
# 内核 API 探活 (curl 优先, busybox wget 回退)
api_ok() {
    if command -v curl >/dev/null 2>&1; then
        curl -s -m 2 -H "Authorization: Bearer $secret" "http://127.0.0.1:$db_port/version" >/dev/null 2>&1
    else
        wget -q -T 2 -O /dev/null --header="Authorization: Bearer $secret" "http://127.0.0.1:$db_port/version" 2>/dev/null
    fi
}
do_start_kernel() {
    # 防多实例: 已有 CrashCore 在跑则不重拉 (cron @reboot boot 与 install/start 并行场景)
    pidof CrashCore >/dev/null 2>&1 && { log "内核已在运行"; return 0; }
    rm -f "$SCDIR/.stopped" 2>/dev/null
    cd "$SCDIR" 2>/dev/null
    nohup "$TMP/CrashCore" run -D "$SCDIR" -C "$TMP/fragments" > "$TMP/sb.log" 2>&1 &
    echo $! > "$TMP/sb.pid"
    host=$(lan_ip); i=0
    while [ "$i" -lt 10 ]; do
        i=$((i+1)); sleep 1
        api_ok && { log "sing-box 已启动 · 面板 http://$host:$db_port/ui · 密钥 $secret"; return 0; }
        [ -z "$(pidof CrashCore 2>/dev/null)" ] && break
    done
    warn "内核已后台运行, API 未就绪, 查日志: $TMP/sb.log"; return 0
}
do_stop_kernel() {
    [ -f "$TMP/sb.pid" ] && kill "$(cat "$TMP/sb.pid")" 2>/dev/null
    pidof CrashCore >/dev/null 2>&1 && killall CrashCore 2>/dev/null
    sleep 1
}
service_restart() {
    do_stop_kernel
    gen_config || return 1
    do_start_kernel
    return 0
}
# 仅重启内核 (供看门狗调用, 不重复拉看门狗)
service_rebuild() {
    gen_config || return 1
    do_start_kernel
    return 0
}

# ---------- 命令入口 ----------
case "${1:-status}" in
    status|""|help|-h)
        host=$(lan_ip)
        echo "===== mibox-lite 状态 ====="
        echo "  内核   : $(pidof CrashCore >/dev/null 2>&1 && echo 运行中 || echo 停止)"
        echo "  面板   : http://$host:$db_port/ui   密钥: ${secret:-未设置}"
        echo "  节点   : $([ -s "$SCDIR/nodes.json" ] && echo "已导入 $(grep -c '"tag"' "$SCDIR/nodes.json" 2>/dev/null || echo '?') 个标签" || echo '未导入 (final=直连)')"
        echo "  广告   : $adblock $([ -s "$RULEDIR/adblock.srs" ] && echo "$(du -h "$RULEDIR/adblock.srs" | awk '{print $1}') 已缓存" || echo '未缓存')"
        echo "  CN分流 : $cn_split $([ -s "$RULEDIR/cn-domain.srs" ] && echo 已缓存 || echo '未缓存(全代理)')"
        echo "  看门狗 : cron 每 5 分钟巡检 (crontab -l | grep SClite)"
        echo "  订阅   : ${sub_url:-未设置}"
        echo "  命令   : start|stop|restart|sub URL|ads|update|scripts|status|uninstall"
        ;;
    start)
        fetch_resources || exit 1
        sh "$SCDIR/fw.sh" start || warn "防火墙注入未完成"
        do_stop_kernel; gen_config; do_start_kernel
        ;;
    stop) sh "$SCDIR/fw.sh" stop; do_stop_kernel; touch "$SCDIR/.stopped"; log "已停止 (标记 .stopped, 看门狗不再拉起; 重新运行 start 清除)" ;;
    restart) do_stop_kernel; sh "$SCDIR/fw.sh" start; gen_config; do_start_kernel ;;
    sub) sub_import "$2" ;;
    ads)
        case "${2:-on}" in
            on)  setcfg adblock ON;  log "广告拦截: 开";;
            off) setcfg adblock OFF; log "广告拦截: 关";;
            update)
                dl "$RULEDIR/adblock.source.json" "$AD_JSON" || { warn "广告规则下载失败"; exit 1; }
                [ -f "$CFG" ] && . "$CFG" 2>/dev/null
                adblock_compile; log "广告规则已更新";;
            *) err "用法: crash ads [on|off|update]";;
        esac
        [ -f "$CFG" ] && . "$CFG" 2>/dev/null
        pidof CrashCore >/dev/null 2>&1 && service_restart && log "已重启生效"
        ;;
    scripts)
        # 从 GitHub 仓库更新脚本本身 (crash/fw/boot), 内核与规则不受影响
        [ -z "$REPO" ] && REPO=$(cat "$CFG" 2>/dev/null | grep '^repo=' | sed "s/repo='//; s/'$//")
        [ -z "$REPO" ] && { err "未知脚本源, 先执行: echo \"repo='<你的仓库raw前缀>'\" >> $CFG"; exit 1; }
        log "更新脚本: $REPO"
        dl "$TMP/_crash" "$REPO/files/crash" && cp -f "$TMP/_crash" "$SCDIR/crash" && chmod +x "$SCDIR/crash"
        dl "$TMP/_fw" "$REPO/files/fw.sh" && cp -f "$TMP/_fw" "$SCDIR/fw.sh"
        dl "$TMP/_boot" "$REPO/files/boot.sh" && cp -f "$TMP/_boot" "$SCDIR/boot.sh"
        rm -f "$TMP/_crash" "$TMP/_fw" "$TMP/_boot"
        log "脚本已更新 (如需更新内核/面板/规则, 执行: crash update)"
        ;;
    update)
        fetch_resources 1 && log "资源已更新 (内核/面板/广告/CN规则)"
        [ -f "$CFG" ] && . "$CFG" 2>/dev/null
        pidof CrashCore >/dev/null 2>&1 && service_restart
        ;;
    service-rebuild)
        # 供看门狗调用: 重建配置 + 拉内核 (不拉看门狗, 防互拉成环)
        gen_config && do_start_kernel
        ;;
    install-prepare)
        [ -z "$secret" ] && { secret=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n' | cut -c1-32); setcfg secret "$secret"; }
        fetch_resources 1
        log "资源就绪"
        ;;
    uninstall)
        do_stop_kernel; sh "$SCDIR/fw.sh" stop 2>/dev/null
        rm -f "$SCDIR/.stopped" 2>/dev/null
        # 清理自启+看门狗 cron (crontab 命令 + MiWiFi crontabs 文件两种路径)
        command -v crontab >/dev/null 2>&1 && crontab -l 2>/dev/null | grep -v 'SClite' | crontab - 2>/dev/null
        for cf in /etc/crontabs/root /data/etc/crontabs/root /etc/storage/cron/crontabs/root; do
            [ -w "$cf" ] && { grep -v 'SClite' "$cf" > /tmp/sc_cron && cat /tmp/sc_cron > "$cf"; rm -f /tmp/sc_cron; }
        done
        rm -rf "$SCDIR" "$TMP"
        log "已卸载 (资源/自启/看门狗/防火墙/cron 已清理)"
        ;;
    *) err "未知命令: $1"; echo "命令: start|stop|restart|sub URL|ads|update|status|uninstall";;
esac
